import threading
import time
mutex = threading.Semaphore(1)
wrt = threading.Semaphore(1)
read_count = 0
shared_data = 0
def reader(reader_id):
    global read_count
    mutex.acquire()
    read_count += 1
    if read_count == 1:
        wrt.acquire()
    mutex.release()
    print(
        f"Reader {reader_id}: read shared_data = {shared_data}"
    )
    time.sleep(0.2)
    mutex.acquire()
    read_count -= 1
    if read_count == 0:
        wrt.release()
    mutex.release()
def writer(writer_id):
    global shared_data
    wrt.acquire()
    shared_data += 1
    print(
        f"Writer {writer_id}: wrote shared_data = {shared_data}"
    )
    time.sleep(0.3)
    wrt.release()
# Create writer and reader threads
w1 = threading.Thread(target=writer, args=(1,))
readers = [
    threading.Thread(target=reader, args=(i + 1,))
    for i in range(5)
]
w2 = threading.Thread(target=writer, args=(2,))
# Start threads
w1.start()
for r in readers:
    r.start()
w2.start()
# Wait for all threads
for r in readers:
    r.join()
w1.join()
w2.join()
